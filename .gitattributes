# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files
*.dart text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.arb text eol=lf
*.gradle text eol=lf
*.xml text eol=lf
*.swift text eol=lf
*.kt text eol=lf
*.h text eol=lf
*.m text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.cmake text eol=lf
*.sh text eol=lf

# Denote binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
