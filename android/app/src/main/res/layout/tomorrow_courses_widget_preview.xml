<?xml version="1.0" encoding="utf-8"?>
<!--
  近日课表小组件的「预览布局」（Android 12+ 的 android:previewLayout）。

  约束（必须遵守）：
  1. 静态示例内容，仅用于小组件选择器 / 固定弹窗里的预览，不会被真实数据驱动；
  2. 不使用 RemoteViewsService / AdapterView 适配器；
  3. 不在任何 View 上声明 id —— 预览布局一次性 inflate，不注册 id 就不可能和
     tomorrow_courses_widget.xml（widget_root / today_courses_list / tomorrow_courses_list /
     today_empty_view / tomorrow_empty_view ...）产生 id 冲突；
  4. 只使用 RemoteViews 白名单内的 View（LinearLayout / FrameLayout / TextView / ImageView），
     不使用 android.view.View（未标注 @RemoteView，会抛 "Class not allowed to be inflated"），
     所以垂直分隔线用 1dp 宽的 TextView 实现。

  尺寸：targetCellWidth/Height = 4x2（约 250dp x 110dp），左右两栏等分。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_modern_background"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingLeft="14dp"
    android:paddingTop="12dp"
    android:paddingRight="14dp"
    android:paddingBottom="12dp">

    <!-- ==================== 今日栏 ==================== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.05"
            android:text="TODAY"
            android:textAllCaps="true"
            android:textColor="@color/time_indicator_text_light"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- 示例课程 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="@drawable/modern_accent_indicator" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="数据结构"
                    android:textColor="@color/course_title_text_light"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="08:00 · 逸夫楼 B302"
                    android:textColor="@color/course_info_text_light"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 示例课程 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="@drawable/modern_accent_indicator" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="体育"
                    android:textColor="@color/course_title_text_light"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="14:30 · 田径场"
                    android:textColor="@color/course_info_text_light"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 垂直分隔线：TextView 代替 View -->
    <TextView
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="4dp"
        android:background="@color/widget_divider_light" />

    <!-- ==================== 明日栏 ==================== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.05"
            android:text="TOMORROW"
            android:textAllCaps="true"
            android:textColor="@color/widget_empty_text_secondary_light"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- 示例课程 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="@drawable/modern_accent_indicator" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="线性代数"
                    android:textColor="@color/course_title_text_light"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="08:00 · 教二楼 101"
                    android:textColor="@color/course_info_text_light"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 示例课程 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="@drawable/modern_accent_indicator" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="大学物理"
                    android:textColor="@color/course_title_text_light"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="10:10 · 实验楼 3-201"
                    android:textColor="@color/course_info_text_light"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
